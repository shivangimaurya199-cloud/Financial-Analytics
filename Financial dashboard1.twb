      <aliases enabled='yes' />
      <column caption='Adjusted Close' datatype='real' name='[Adjusted_Close]' role='measure' type='quantitative' />
      <column caption='Scenario Price' datatype='real' name='[Calculation_0393389139226624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sector] = [Parameters].[Parameter 2]&#13;&#10;OR [Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;THEN [Adjusted_Close] *&#13;&#10;     (1 + [Parameters].[Parameter 1]/100) *&#13;&#10;     (1 + [Parameters].[Parameter 3]/100)&#13;&#10;&#13;&#10;ELSE [Adjusted_Close] *&#13;&#10;     (1 + [Parameters].[Parameter 3]/100)&#13;&#10;END' />
      </column>
      <column caption='Daily Return' datatype='real' name='[Calculation_0393389139464193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Adjusted_Close]) - LOOKUP(SUM([Adjusted_Close]), -1))&#13;&#10;/&#13;&#10;LOOKUP(SUM([Adjusted_Close]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Scenario Return' datatype='real' name='[Calculation_0393389140574210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0393389139226624]) - LOOKUP(SUM([Calculation_0393389139226624]), -1))&#13;&#10;/&#13;&#10;LOOKUP(SUM([Calculation_0393389139226624]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Price Change ($)' datatype='real' name='[Calculation_0393389141413891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    AVG([Close_Price]) - LOOKUP(AVG([Close_Price]), -1),&#13;&#10;    0&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Change %' datatype='real' name='[Calculation_0393389141524484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Close_Price]) - LOOKUP(SUM([Close_Price]), -1)) &#13;&#10;/&#13;&#10;LOOKUP(SUM([Close_Price]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Gain / Loss Indicator' datatype='string' name='[Calculation_0393389141778437]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0393389141413891] &gt;= 0&#13;&#10;THEN &quot;Gain&quot;&#13;&#10;ELSE &quot;Loss&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Volatility 30D' datatype='real' name='[Calculation_0393389143613446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_STDEV([Calculation_0393389139464193], -29, 0)'>
