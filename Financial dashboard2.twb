      <aliases enabled='yes' />
      <column aggregation='None' datatype='integer' name='[Adjusted Close (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='1' formula='[Adjusted_Close]' peg='0' size='13.2' />
      </column>
      <column datatype='real' name='[Adjusted_Close]' role='measure' type='quantitative' />
      <column caption='Scenario Price' datatype='real' name='[Calculation_0393389139226624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sector] = [Parameters].[Parameter 2]&#13;&#10;OR [Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;THEN [Adjusted_Close] *&#13;&#10;     (1 + [Parameters].[Parameter 1]/100) *&#13;&#10;     (1 + [Parameters].[Parameter 3]/100)&#13;&#10;&#13;&#10;ELSE [Adjusted_Close] *&#13;&#10;     (1 + [Parameters].[Parameter 3]/100)&#13;&#10;END' />
      </column>
      <column caption='Daily Return' datatype='real' name='[Calculation_0393389139464193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(SUM([Adjusted_Close]), -1)) THEN&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    (SUM([Adjusted_Close]) - LOOKUP(SUM([Adjusted_Close]), -1))&#13;&#10;    /&#13;&#10;    LOOKUP(SUM([Adjusted_Close]), -1)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Scenario Return' datatype='real' name='[Calculation_0393389140574210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0393389139226624]) - LOOKUP(SUM([Calculation_0393389139226624]), -1))&#13;&#10;/&#13;&#10;LOOKUP(SUM([Calculation_0393389139226624]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Price Change ($)' datatype='real' name='[Calculation_0393389141413891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#13;&#10;    AVG([Close_Price]) - LOOKUP(AVG([Close_Price]), -1),&#13;&#10;    0&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Change %' datatype='real' name='[Calculation_0393389141524484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Close_Price]) - LOOKUP(SUM([Close_Price]), -1)) &#13;&#10;/&#13;&#10;LOOKUP(SUM([Close_Price]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Gain / Loss Indicator' datatype='string' name='[Calculation_0393389141778437]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0393389141413891] &gt;= 0&#13;&#10;THEN &quot;Gain&quot;&#13;&#10;ELSE &quot;Loss&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Volatility 30D' datatype='real' name='[Calculation_0393389143613446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_STDEV([Calculation_0393389139464193], -29, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Volatility 90D' datatype='real' name='[Calculation_0393389143764999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_STDEV([Calculation_0393389139464193], -89, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Normalized Weight' datatype='real' name='[Calculation_0812853899448320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Ticker]&#13;&#10;&#13;&#10;WHEN &quot;AAPL&quot; THEN [Parameters].[Parameter 4]&#13;&#10;WHEN &quot;MSFT&quot; THEN [Parameters].[Parameter 5]&#13;&#10;WHEN &quot;JPM&quot; THEN [Parameters].[Parameter 6]&#13;&#10;WHEN &quot;JNJ&quot; THEN [Parameters].[Parameter 7]&#13;&#10;&#13;&#10;END&#13;&#10;/&#13;&#10;(&#13;&#10;[Parameters].[Parameter 4] +&#13;&#10;[Parameters].[Parameter 5] +&#13;&#10;[Parameters].[Parameter 6] +&#13;&#10;[Parameters].[Parameter 7]&#13;&#10;)' />
      </column>
      <column caption='Cumulative Return' datatype='real' name='[Calculation_0905762951733248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_0393389139464193])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Investment' datatype='real' name='[Calculation_0905762954481665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Adjusted_Close])' />
      </column>
      <column caption='Average Risk' datatype='real' name='[Calculation_0905762960699394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0959363094396934])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Annualized Return' datatype='real' name='[Calculation_0959363092049920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='POWER(&#13;&#10;    (WINDOW_AVG(1 + [Calculation_0393389139464193])),&#13;&#10;    252&#13;&#10;) - 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sharpe Ratio' datatype='real' name='[Calculation_0959363092295681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0959363092049920] - 0.02)&#13;&#10;/ (WINDOW_STDEV([Calculation_0393389139464193]) * SQRT(252))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Running Max Price' datatype='real' name='[Calculation_0959363092488194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_MAX(SUM([Adjusted_Close]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Drawdown' datatype='real' name='[Calculation_0959363093143555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Adjusted_Close])-[Calculation_0959363092488194])&#13;&#10;/&#13;&#10;[Calculation_0959363092488194]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='max Drawdown' datatype='real' name='[Calculation_0959363093909508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MIN([Calculation_0959363093143555])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='VaR 95%' datatype='real' name='[Calculation_0959363094188037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='- WINDOW_PERCENTILE([Calculation_0393389139464193], 0.05)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='VaR 99%' datatype='real' name='[Calculation_0959363094396934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='- WINDOW_PERCENTILE([Calculation_0393389139464193], 0.01)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Market Return' datatype='real' name='[Calculation_0959363112333328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_0393389139464193])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Beta' datatype='real' name='[Calculation_0959363112640529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_COVAR([Calculation_0393389139464193], [Calculation_0959363112333328])&#13;&#10;/&#13;&#10;WINDOW_VAR([Calculation_0959363112333328])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CAPM Expected Return' datatype='real' name='[Calculation_0959363112996882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.02 + [Calculation_0959363112640529] * ([Calculation_0959363092049920] - 0.02)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Alpha' datatype='real' name='[Calculation_0959363113512979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0959363092049920] - [Calculation_0959363112996882]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Correlation Strength' datatype='real' name='[Calculation_0959363113734164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_CORR([Calculation_0393389139464193], [Calculation_0959363112333328])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Risk Level' datatype='string' name='[Calculation_0959363114106901]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0393389143613446] &lt; 0.01 THEN &quot;Low Risk&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_0393389143613446] &lt; 0.02 THEN &quot;Moderate Risk&quot;&#13;&#10;&#13;&#10;ELSE &quot;High Risk&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
