    <worksheet name='alpha performance'>
      <table>
        <view>
          <datasources>
            <datasource caption='AlphaPulse_Dataset (AlphaPulse_Dataset)' name='federated.1yo26tv1il4wny1esd3i31sh3ex6' />
          </datasources>
          <datasource-dependencies datasource='federated.1yo26tv1il4wny1esd3i31sh3ex6'>
            <column datatype='real' name='[Adjusted_Close]' role='measure' type='quantitative' />
            <column caption='Daily Return' datatype='real' name='[Calculation_0393389139464193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(LOOKUP(SUM([Adjusted_Close]), -1)) THEN&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    (SUM([Adjusted_Close]) - LOOKUP(SUM([Adjusted_Close]), -1))&#13;&#10;    /&#13;&#10;    LOOKUP(SUM([Adjusted_Close]), -1)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Annualized Return' datatype='real' name='[Calculation_0959363092049920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='POWER(&#13;&#10;    (WINDOW_AVG(1 + [Calculation_0393389139464193])),&#13;&#10;    252&#13;&#10;) - 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Market Return' datatype='real' name='[Calculation_0959363112333328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_0393389139464193])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Beta' datatype='real' name='[Calculation_0959363112640529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_COVAR([Calculation_0393389139464193], [Calculation_0959363112333328])&#13;&#10;/&#13;&#10;WINDOW_VAR([Calculation_0959363112333328])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CAPM Expected Return' datatype='real' name='[Calculation_0959363112996882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.02 + [Calculation_0959363112640529] * ([Calculation_0959363092049920] - 0.02)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Alpha' datatype='real' name='[Calculation_0959363113512979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0959363092049920] - [Calculation_0959363112996882]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Ticker]' role='dimension' type='nominal' />
            <column-instance column='[Adjusted_Close]' derivation='None' name='[none:Adjusted_Close:qk]' pivot='key' type='quantitative' />
