    <worksheet name='volatility analysis'>
      <table>
        <view>
          <datasources>
            <datasource caption='AlphaPulse_Dataset (AlphaPulse_Dataset)' name='federated.1yo26tv1il4wny1esd3i31sh3ex6' />
          </datasources>
          <datasource-dependencies datasource='federated.1yo26tv1il4wny1esd3i31sh3ex6'>
            <column datatype='real' name='[Adjusted_Close]' role='measure' type='quantitative' />
            <column caption='Daily Return' datatype='real' name='[Calculation_0393389139464193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(LOOKUP(SUM([Adjusted_Close]), -1)) THEN&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    (SUM([Adjusted_Close]) - LOOKUP(SUM([Adjusted_Close]), -1))&#13;&#10;    /&#13;&#10;    LOOKUP(SUM([Adjusted_Close]), -1)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Volatility 90D' datatype='real' name='[Calculation_0393389143764999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_STDEV([Calculation_0393389139464193], -89, 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Annualized Return' datatype='real' name='[Calculation_0959363092049920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='POWER(&#13;&#10;    (WINDOW_AVG(1 + [Calculation_0393389139464193])),&#13;&#10;    252&#13;&#10;) - 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Ticker]' role='dimension' type='nominal' />
            <column-instance column='[Ticker]' derivation='None' name='[none:Ticker:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0393389143764999]' derivation='User' name='[usr:Calculation_0393389143764999:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.1yo26tv1il4wny1esd3i31sh3ex6].[Calculation_0393389139464193]' ordering-type='Rows' />
            </column-instance>
            <column-instance column='[Calculation_0959363092049920]' derivation='User' name='[usr:Calculation_0959363092049920:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.1yo26tv1il4wny1esd3i31sh3ex6].[Calculation_0393389139464193]' ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.1yo26tv1il4wny1esd3i31sh3ex6].[usr:Calculation_0959363092049920:qk]' />
            </encodings>
          </pane>
        </panes>
